# .gitignore for AutoParts Portal (Java/Maven/Spring Boot)

# ---- Compiled files ----
*.class
*.jar
*.war
*.ear
*.nar

# ---- Maven ----
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ---- IDE files ----
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
*.eclipse

# IntelliJ IDEA
.idea/
*.iml

# VS Code
.vscode/
!.vscode/extensions.json

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ---- Spring Boot ----
application-local.properties
application-secret*.properties
*.env

# ---- Sensitive files ----
src/main/resources/application-prod.properties
src/main/resources/secrets.properties
.env
*.pem
*.key
*.crt
*.p12

# ---- OS files ----
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
*~

# ---- Logs ----
*.log
logs/
log/

# ---- Test output ----
target/surefire-reports/
target/failsafe-reports/
target/screenshots/

# ---- Docker ----
.dockerignore

# ---- Node (if used for frontend tooling) ----
node_modules/
npm-debug.log

# ---- Ansible ----
ansible/*.retry
ansible/vault_pass.txt
